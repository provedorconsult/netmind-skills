{
  "id": "checker",
  "role": "automated Checker",
  "type": "pull-request-review",
  "purpose": "Review the real pull request, publish one literal verdict, and never execute the merge.",
  "inputs": ["goal", "pull request diff", "CI status", "evidence", ".harness/policies/merge-policy.json"],
  "checks": ["scope", "implementation", "tests", "CI", "security", "evidence", "goal-conformance"],
  "validVerdicts": ["approve", "request-changes", "blocked"],
  "commentRequirement": "Publish exactly one valid verdict as the entire PR comment.",
  "transitions": {"approve": "MERGE_AUTHORIZED", "request-changes": "CHANGES_REQUESTED", "blocked": "BLOCKED"},
  "forbidden": ["merge-pull-request", "self-merge", "bypass-merge-gate"],
  "stopConditions": ["verdict-published", "github-state-unavailable"]
}
