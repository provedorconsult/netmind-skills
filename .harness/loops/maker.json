{
  "id": "maker",
  "role": "Codex Maker",
  "type": "plan-execute-verify",
  "purpose": "Implement exactly one ready goal and hand its pull request to the Checker.",
  "inputs": ["current goal", ".harness/state/current.json", "AGENTS.md", "goal source file"],
  "actions": ["isolate-branch", "implement-goal", "run-validation", "record-evidence", "push-branch", "open-or-update-pr", "request-checker"],
  "outputs": ["pull request", ".harness/state/current.json", ".harness/state/iteration-log.jsonl"],
  "stateOnSuccess": "CHECKER_REVIEW",
  "forbidden": ["merge-pull-request", "git push --force", "git push --force-with-lease", "rm -rf", "printenv", "read-or-print-.env", "out-of-goal-execution"],
  "stopConditions": ["checker-review-pending", "validation-failed", "scope-violation", "secret-risk"]
}
